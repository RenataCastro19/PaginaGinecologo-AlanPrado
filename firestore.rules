rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verdadero si el usuario inició sesión y su UID está registrado en la colección administradores
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    // Lista de administradores: solo se administra desde la consola de Firebase.
    // Cada usuario puede leer únicamente su propio documento (para que el panel verifique su acceso).
    match /administradores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Contenido que ve el público en la landing
    match /sitio/publicado {
      allow read: if true;
      allow create, update: if esAdmin();   // nunca se borra (la landing se quedaría sin contenido)
    }

    // Contenido en edición desde el panel (no es público)
    match /sitio/borrador {
      allow read, create, update: if esAdmin();   // nunca se borra
    }

    // Copia de cada publicación: se puede crear y consultar, pero nunca modificar ni borrar
    match /historial/{publicacionId} {
      allow read, create: if esAdmin();
      allow update, delete: if false;
    }

    // Cualquier otra ruta queda bloqueada por omisión
  }
}
